  <script>
    const header = document.getElementById('siteHeader');
    const menuToggle = document.getElementById('menuToggle');
    const navLinks = document.getElementById('navLinks');

    function updateHeader() {
      header.classList.toggle('scrolled', window.scrollY > 24);
    }
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });

    menuToggle.addEventListener('click', () => {
      const open = navLinks.classList.toggle('open');
      menuToggle.setAttribute('aria-expanded', String(open));
      menuToggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      document.body.classList.toggle('menu-open', open);
    });
    navLinks.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        navLinks.classList.remove('open');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.setAttribute('aria-label', 'Open navigation menu');
        document.body.classList.remove('menu-open');
      });
    });

    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));


    // Product details: open an individual view for every timepiece.
    const watchModal = document.getElementById('watchModal');
    const watchModalImage = document.getElementById('watchModalImage');
    const watchModalTitle = document.getElementById('watchModalTitle');
    const watchModalDescription = document.getElementById('watchModalDescription');
    const watchModalWhatsApp = document.getElementById('watchModalWhatsApp');
    const closeWatchModal = () => {
      watchModal.classList.remove('open');
      watchModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };
    document.querySelectorAll('.product-card').forEach(card => {
      const link = card.querySelector('a');
      if (!link) return;
      link.setAttribute('href', '#watch-details');
      link.setAttribute('aria-haspopup', 'dialog');
      link.addEventListener('click', event => {
        event.preventDefault();
        const title = card.querySelector('h3')?.textContent.trim() || 'Atelier Timepiece';
        const description = card.querySelector('.product-info p')?.textContent.trim() || 'A distinctive expression from the Atelier collection.';
        const image = card.querySelector('.product-image');
        watchModalTitle.textContent = title;
        watchModalDescription.textContent = description;
        watchModalImage.src = image ? image.src : '';
        watchModalImage.alt = image ? image.alt : title;
        const message = `Hello Titan Timekeepers Atelier, I would like to enquire about ${title}. Please share availability and details.`;
        watchModalWhatsApp.href = `https://wa.me/918657678522?text=${encodeURIComponent(message)}`;
        watchModal.classList.add('open');
        watchModal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        document.getElementById('watchModalClose').focus();
      });
    });
    document.getElementById('watchModalClose').addEventListener('click', closeWatchModal);
    watchModal.addEventListener('click', event => { if (event.target === watchModal) closeWatchModal(); });
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && watchModal.classList.contains('open')) closeWatchModal(); });

    document.getElementById('year').textContent = new Date().getFullYear();

    // Appointment requests are handed to WhatsApp; the visitor reviews and sends the message.
    document.getElementById('appointmentForm').addEventListener('submit', (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const message = [
        'Hello Titan Timekeepers Atelier, I would like to request an appointment.',
        `Name: ${data.get('name')}`,
        `Email: ${data.get('email')}`,
        `Interest: ${data.get('interest')}`,
        `Preferred timing: ${data.get('timing') || 'Flexible'}`,
        `Message: ${data.get('message') || 'No additional details provided.'}`
      ].join('\n');
      document.getElementById('formStatus').textContent = 'Opening WhatsApp with your request. Review the details and press Send in WhatsApp.';
      window.open(`https://wa.me/918657678522?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
    });

    // Live search across all concept timepieces.
    const watchSearch = document.getElementById('watchSearch');
    const productCards = [...document.querySelectorAll('.product-card')];
    const searchResults = document.getElementById('searchResults');
    watchSearch.addEventListener('input', () => {
      const query = watchSearch.value.trim().toLowerCase();
      let count = 0;
      productCards.forEach(card => {
        const match = card.textContent.toLowerCase().includes(query);
        card.hidden = !match;
        if (match) count++;
      });
      searchResults.textContent = query ? `${count} timepiece${count === 1 ? '' : 's'} found for “${watchSearch.value.trim()}”.` : `Showing all ${productCards.length} concept timepieces.`;
    });

    // Local selection cart. No checkout or payment is implied; enquiries are sent through WhatsApp.
    const cartOverlay = document.getElementById('cartOverlay');
    const cartItemsEl = document.getElementById('cartItems');
    const cartCount = document.getElementById('cartCount');
    const selection = readStored('titan-selection');
    let activeWatch = null;
    const escapeHTML = value => String(value).replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    function renderSelection() {
      cartCount.textContent = selection.length;
      localStorage.setItem('titan-selection', JSON.stringify(selection));
      if (!selection.length) {
        cartItemsEl.innerHTML = '<p class="cart-empty">Your selection is empty. Open a timepiece to add it here.</p>';
        return;
      }
      cartItemsEl.innerHTML = selection.map((item,index) => `<article class="cart-item"><img src="${escapeHTML(item.image)}" alt=""><div><h3>${escapeHTML(item.title)}</h3><p>Price on request</p></div><button class="cart-remove" type="button" data-remove="${index}" aria-label="Remove ${escapeHTML(item.title)}">Remove</button></article>`).join('');
    }
    function openCart() { cartOverlay.classList.add('open'); cartOverlay.setAttribute('aria-hidden','false'); document.body.style.overflow='hidden'; document.getElementById('closeCart').focus(); }
    function closeCart() { cartOverlay.classList.remove('open'); cartOverlay.setAttribute('aria-hidden','true'); document.body.style.overflow=''; document.getElementById('openCart').focus(); }
    document.getElementById('openCart').addEventListener('click',openCart);
    document.getElementById('closeCart').addEventListener('click',closeCart);
    cartOverlay.addEventListener('click',event=>{if(event.target===cartOverlay)closeCart();});
    cartItemsEl.addEventListener('click',event=>{const button=event.target.closest('[data-remove]');if(button){selection.splice(Number(button.dataset.remove),1);renderSelection();}});
    document.getElementById('clearCart').addEventListener('click',()=>{selection.length=0;renderSelection();});
    document.getElementById('cartEnquire').addEventListener('click',()=>{
      if(!selection.length){openCart();return;}
      const message='Hello Titan Timekeepers Atelier, I would like to enquire about these selected timepieces:\n'+selection.map(item=>'• '+item.title).join('\n')+'\nPlease share availability and details.';
      window.open('https://wa.me/918657678522?text='+encodeURIComponent(message),'_blank','noopener,noreferrer');
    });
    document.getElementById('addToCart').addEventListener('click',()=>{
      if(!activeWatch)return;
      if(!selection.some(item=>item.title===activeWatch.title))selection.push(activeWatch);
      renderSelection();
      const button=document.getElementById('addToCart');button.textContent='✓ Added to Selection';
      setTimeout(()=>{if(button.isConnected)button.textContent='＋ Add to Selection';},1600);
    });
    const originalProductClick = productCards;
    // Product modal interaction also updates the active item for the selection cart.
    originalProductClick.forEach(card=>{
      const link=card.querySelector('a');
      if(!link)return;
      link.addEventListener('click',()=>{
        const image=card.querySelector('.product-image');
        activeWatch={title:card.querySelector('h3')?.textContent.trim()||'Atelier Timepiece',image:image?.currentSrc||image?.src||'',description:card.querySelector('.product-info p')?.textContent.trim()||''};
        document.getElementById('addToCart').textContent=selection.some(item=>item.title===activeWatch.title)?'✓ Already in Selection':'＋ Add to Selection';
      });
    });
    document.addEventListener('keydown',event=>{if(event.key==='Escape'&&cartOverlay.classList.contains('open'))closeCart();});
    renderSelection();

    // Optional dark theme; choice is remembered on this device.
    const themeToggle = document.getElementById('themeToggle');
    const savedTheme = localStorage.getItem('titan-theme');
    if (savedTheme === 'dark') { document.body.classList.add('dark-mode'); themeToggle.setAttribute('aria-pressed','true'); themeToggle.textContent='☼ Light mode'; themeToggle.setAttribute('aria-label','Switch to light theme'); }
    themeToggle.addEventListener('click', () => {
      const dark = document.body.classList.toggle('dark-mode');
      localStorage.setItem('titan-theme', dark ? 'dark' : 'light');
      themeToggle.setAttribute('aria-pressed', String(dark));
      themeToggle.textContent = dark ? '☼ Light mode' : '◐ Theme';
      themeToggle.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
    });

    // Wishlist and recently viewed are stored locally; no account or server is required.
    const readStored = (key) => { try { const v = JSON.parse(localStorage.getItem(key) || '[]'); return Array.isArray(v) ? v : []; } catch { return []; } };
    let wishlist = readStored('titan-wishlist');
    let recentlyViewed = readStored('titan-recent');
    const productData = card => {
      const img = card.querySelector('.product-image');
      return { title: card.querySelector('h3')?.textContent.trim() || 'Atelier Timepiece', image: img?.currentSrc || img?.src || '', description: card.querySelector('.product-info p')?.textContent.trim() || '' };
    };
    const cardMarkup = item => `<button class="recent-card" type="button" data-open-watch="${escapeHTML(item.title)}"><img src="${escapeHTML(item.image)}" alt="" loading="lazy"><strong>${escapeHTML(item.title)}</strong><span>View timepiece ↗</span></button>`;
    function renderSavedShelves() {
      const recentSection = document.getElementById('recentlyViewed');
      const wishlistSection = document.getElementById('wishlistShelf');
      document.getElementById('recentGrid').innerHTML = recentlyViewed.map(cardMarkup).join('');
      document.getElementById('wishlistGrid').innerHTML = wishlist.map(cardMarkup).join('');
      recentSection.hidden = !recentlyViewed.length; wishlistSection.hidden = !wishlist.length;
      productCards.forEach(card => {
        const data = productData(card); let btn = card.querySelector('.wishlist-button');
        if (!btn) { btn = document.createElement('button'); btn.type='button'; btn.className='wishlist-button'; btn.setAttribute('aria-label',`Add ${data.title} to wishlist`); btn.innerHTML='♡'; card.querySelector('.product-image-wrap')?.appendChild(btn); }
        const saved = wishlist.some(item => item.title === data.title); btn.setAttribute('aria-pressed',String(saved)); btn.innerHTML=saved?'♥':'♡'; btn.setAttribute('aria-label',`${saved?'Remove':'Add'} ${data.title} ${saved?'from':'to'} wishlist`);
      });
    }
    productCards.forEach(card => {
      const link = card.querySelector('a'); if (!link) return;
      link.addEventListener('click', () => {
        const data = productData(card);
        recentlyViewed = [data, ...recentlyViewed.filter(item => item.title !== data.title)].slice(0,4);
        localStorage.setItem('titan-recent', JSON.stringify(recentlyViewed)); renderSavedShelves();
      });
    });
    document.querySelector('.collection-grid').addEventListener('click', event => {
      const btn = event.target.closest('.wishlist-button'); if (!btn) return; event.preventDefault(); event.stopPropagation();
      const card = btn.closest('.product-card'); const data = productData(card);
      wishlist = wishlist.some(item => item.title === data.title) ? wishlist.filter(item => item.title !== data.title) : [data, ...wishlist].slice(0,30);
      localStorage.setItem('titan-wishlist', JSON.stringify(wishlist)); renderSavedShelves();
    });
    function openSavedWatch(title) {
      const card = productCards.find(item => item.querySelector('h3')?.textContent.trim() === title);
      if (card) { card.querySelector('a')?.click(); document.getElementById('collection').scrollIntoView({behavior:'smooth',block:'start'}); }
    }
    document.getElementById('recentGrid').addEventListener('click',event=>{const item=event.target.closest('[data-open-watch]');if(item)openSavedWatch(item.dataset.openWatch);});
    document.getElementById('wishlistGrid').addEventListener('click',event=>{const item=event.target.closest('[data-open-watch]');if(item)openSavedWatch(item.dataset.openWatch);});
    renderSavedShelves();

    document.getElementById('privacyLink').addEventListener('click', (event) => {
      event.preventDefault();
      alert('Add your actual privacy policy before publishing this website.');
    });
    document.getElementById('termsLink').addEventListener('click', (event) => {
      event.preventDefault();
      alert('Add your actual terms and conditions before publishing this website.');
    });
  </script>
</body>
</html>
