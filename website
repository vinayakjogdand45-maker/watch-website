<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#fbfaf6">
  <meta name="description" content="Explore the Titan Timekeepers Atelier concept collection: refined timepieces, bespoke consultations, and considered design in a white, gold, and black luxury experience.">
  <meta name="robots" content="index,follow">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Titan Timekeepers Atelier — Time, Considered">
  <meta property="og:description" content="Discover considered design, refined timepieces, and bespoke watch consultations.">
  <meta name="color-scheme" content="light">
  <title>Titan Timekeepers Atelier — Time, Considered.</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: #090d12;
      --ink-soft: #101720;
      --panel: #131c25;
      --cream: #f2eee5;
      --muted: #a9adb0;
      --gold: #c9aa72;
      --gold-light: #e7d3a8;
      --line: rgba(231, 211, 168, .22);
      --serif: "Playfair Display", Georgia, serif;
      --sans: "DM Sans", Arial, sans-serif;
      --page: min(1200px, calc(100% - 48px));
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 90px; }
    body { margin: 0; background: var(--ink); color: var(--cream); font-family: var(--sans); line-height: 1.65; }
    body.menu-open { overflow: hidden; }
    a { color: inherit; text-decoration: none; }
    img { display: block; width: 100%; object-fit: cover; }
    button, input, textarea, select { font: inherit; }
    button, a { -webkit-tap-highlight-color: transparent; }
    ::selection { background: var(--gold); color: var(--ink); }
    .skip-link { position: absolute; left: -9999px; top: 10px; z-index: 1000; background: var(--cream); color: var(--ink); padding: 12px 16px; }
    .skip-link:focus { left: 12px; }
    .container { width: var(--page); margin-inline: auto; }
    .eyebrow { display: flex; align-items: center; gap: 12px; color: var(--gold-light); font-size: .69rem; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; }
    .eyebrow::before { content: ""; display: inline-block; width: 28px; height: 1px; background: var(--gold); }
    h1, h2, h3, p { margin-top: 0; }
    h1, h2, h3 { font-family: var(--serif); font-weight: 400; line-height: 1.12; }
    h1 { font-size: clamp(3.4rem, 8.4vw, 7.8rem); letter-spacing: -.055em; max-width: 850px; margin-bottom: 22px; }
    h2 { font-size: clamp(2.5rem, 5vw, 4.7rem); letter-spacing: -.04em; margin-bottom: 22px; }
    h3 { font-size: clamp(1.45rem, 2.2vw, 2rem); margin-bottom: 12px; }
    .section { padding: 120px 0; }
    .section-heading { max-width: 690px; margin-bottom: 52px; }
    .section-heading p { color: var(--muted); max-width: 540px; margin-bottom: 0; }
    .gold { color: var(--gold-light); }
    .muted { color: var(--muted); }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 13px; min-height: 52px; padding: 0 22px; border: 1px solid var(--gold); color: var(--cream); text-transform: uppercase; letter-spacing: .13em; font-size: .69rem; font-weight: 600; transition: background .25s ease, color .25s ease, transform .25s ease; cursor: pointer; }
    .btn:hover, .btn:focus-visible { background: var(--gold); color: var(--ink); transform: translateY(-2px); }
    .btn .arrow { font-size: 1rem; line-height: 1; }
    .btn-solid { background: var(--gold); color: var(--ink); }
    .btn-solid:hover, .btn-solid:focus-visible { background: var(--gold-light); border-color: var(--gold-light); }
    :focus-visible { outline: 2px solid var(--gold-light); outline-offset: 4px; }

    /* Cinematic luxury-watch opening sequence */
    .watch-intro { position: fixed; inset: 0; z-index: 9999; overflow: hidden; display: grid; place-items: center; isolation: isolate; background: radial-gradient(ellipse at 50% 44%, #1a2025 0%, #090b0e 46%, #020304 100%); animation: intro-away 1.0s cubic-bezier(.7,0,.2,1) 2.25s forwards; }
    .intro-grain { position: absolute; inset: -50%; opacity: .12; pointer-events: none; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.92' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.34'/%3E%3C/svg%3E"); animation: grain-drift .22s steps(2) infinite; }
    .intro-light { position: absolute; inset: -30%; background: conic-gradient(from 225deg at 50% 48%, transparent 0deg, rgba(201,170,114,.02) 42deg, rgba(231,211,168,.16) 52deg, transparent 66deg, transparent 360deg); animation: light-turn 5s linear infinite; }
    .intro-orbit { position: absolute; width: min(76vw, 680px); aspect-ratio: 1; border: 1px solid rgba(201,170,114,.14); border-radius: 50%; box-shadow: 0 0 0 38px rgba(201,170,114,.018), 0 0 0 88px rgba(201,170,114,.014); animation: orbit-in 2s cubic-bezier(.16,1,.3,1) both; }
    .intro-orbit::before, .intro-orbit::after { content: ''; position: absolute; border-radius: 50%; border: 1px solid rgba(231,211,168,.12); inset: 8%; }
    .intro-orbit::after { inset: 17%; border-style: dashed; animation: orbit-spin 38s linear infinite; }
    .watch-intro-inner { position: relative; z-index: 2; display: grid; justify-items: center; gap: 25px; text-align: center; animation: intro-rise 1.5s cubic-bezier(.16,1,.3,1) both; }
    .intro-overline { margin-bottom: 5px; color: rgba(231,211,168,.75); font-size: .56rem; letter-spacing: .42em; text-transform: uppercase; }
    .intro-watch { width: clamp(190px, 28vw, 260px); aspect-ratio: 1; border: 8px solid #8c7148; border-radius: 50%; position: relative; background: radial-gradient(circle at 32% 24%, #37404a 0%, #141b23 25%, #080d12 68%, #1e252b 100%); box-shadow: 0 0 0 2px #e4c88c, 0 0 0 12px rgba(201,170,114,.07), 0 0 70px rgba(201,170,114,.2), inset 0 0 24px #000, inset 0 0 0 2px rgba(255,255,255,.13); transform: perspective(900px) rotateX(12deg) rotateY(-8deg); animation: watch-arrive 1.65s cubic-bezier(.16,1,.3,1) both, watch-float 4s ease-in-out 1.65s infinite; }
    .intro-watch::before { content: ''; position: absolute; inset: 9px; border: 1px solid rgba(231,211,168,.62); border-radius: 50%; box-shadow: inset 0 0 25px rgba(201,170,114,.08); }
    .intro-watch::after { content: 'TITAN  ·  ATELIER'; position: absolute; left: 0; right: 0; top: 27%; text-align: center; color: #e7d3a8; font: 600 7px var(--sans); letter-spacing: 2px; }
    .intro-crown { position: absolute; right: -17px; top: 43%; width: 15px; height: 32px; border: 1px solid #d5b779; border-radius: 3px; background: repeating-linear-gradient(90deg,#765b34 0 2px,#d4b779 2px 3px); box-shadow: 2px 0 8px #000; }
    .watch-tick { position: absolute; left: 50%; top: 13px; width: 2px; height: 10px; background: #e7d3a8; transform-origin: 0 105px; box-shadow: 0 0 6px rgba(231,211,168,.35); }
    .watch-tick:nth-of-type(3n) { height: 15px; width: 3px; }
    .watch-hand { position: absolute; left: 50%; bottom: 50%; width: 3px; height: 31%; background: linear-gradient(#fff0c8,#c9aa72); transform-origin: bottom; border-radius: 3px; animation: hand-sweep 3.8s cubic-bezier(.3,.1,.3,1) both; box-shadow: 0 0 8px rgba(231,211,168,.3); }
    .watch-hand.minute { height: 39%; width: 2px; background: #f2eee5; animation-duration: 4s; }
    .watch-hand.second { height: 43%; width: 1px; background: #bd4438; animation: second-sweep 4s linear both; }
    .watch-pin { position: absolute; left: calc(50% - 5px); top: calc(50% - 5px); width: 10px; height: 10px; border: 2px solid #f3dca8; border-radius: 50%; background: #8c6335; box-shadow: 0 0 9px rgba(231,211,168,.6); }
    .intro-wordmark { color: var(--cream); font: 500 .75rem var(--sans); letter-spacing: .38em; text-transform: uppercase; }
    .intro-wordmark span { display: block; margin-top: 10px; color: var(--gold); font: 400 .62rem var(--sans); letter-spacing: .24em; }
    .intro-tagline { margin: -8px 0 0; color: rgba(242,238,229,.65); font: italic 1rem var(--serif); letter-spacing: .05em; }
    .intro-progress { width: 150px; height: 1px; margin-top: 1px; overflow: hidden; background: rgba(231,211,168,.18); }
    .intro-progress span { display: block; width: 100%; height: 100%; background: var(--gold-light); transform-origin: left; animation: progress-run 4.4s linear both; }
    .intro-enter { position: absolute; bottom: 30px; z-index: 3; color: rgba(231,211,168,.55); font-size: .56rem; letter-spacing: .25em; text-transform: uppercase; animation: intro-pulse 1.8s ease-in-out infinite; }
    @keyframes hand-sweep { from { transform: rotate(-130deg); } to { transform: rotate(235deg); } }
    @keyframes second-sweep { from { transform: rotate(0deg); } to { transform: rotate(1440deg); } }
    @keyframes intro-rise { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes watch-arrive { from { opacity: 0; transform: perspective(900px) rotateX(40deg) rotateY(-30deg) scale(.62); filter: blur(8px); } to { opacity: 1; transform: perspective(900px) rotateX(12deg) rotateY(-8deg) scale(1); filter: blur(0); } }
    @keyframes watch-float { 0%,100% { transform: perspective(900px) rotateX(12deg) rotateY(-8deg) translateY(0); } 50% { transform: perspective(900px) rotateX(8deg) rotateY(-4deg) translateY(-7px); } }
    @keyframes orbit-in { from { opacity: 0; transform: scale(.65) rotate(-35deg); } to { opacity: 1; transform: scale(1) rotate(0); } }
    @keyframes orbit-spin { to { transform: rotate(360deg); } }
    @keyframes light-turn { to { transform: rotate(360deg); } }
    @keyframes grain-drift { 0% { transform: translate(0,0); } 100% { transform: translate(2%,-1%); } }
    @keyframes progress-run { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    @keyframes intro-pulse { 0%,100% { opacity: .45; } 50% { opacity: 1; } }
    @keyframes intro-away { to { opacity: 0; visibility: hidden; } }
    @media (max-width: 560px) { .intro-watch { width: 190px; } .intro-orbit { width: 88vw; } .intro-wordmark { font-size: .66rem; letter-spacing: .26em; } }
    @media (prefers-reduced-motion: reduce) { .watch-intro { display: none; } }
    /* Storytelling panel */
    .story-quote { margin-top: 42px; padding: 25px 0 0; border-top: 1px solid var(--line); color: var(--gold-light); font: italic clamp(1.35rem, 2.3vw, 2rem)/1.4 var(--serif); }
    .story-quote small { display: block; margin-top: 12px; color: var(--muted); font: 600 .62rem var(--sans); letter-spacing: .17em; text-transform: uppercase; }
    .collection-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .product-card:nth-child(n+4) { margin-top: 30px; }
    .product-tag { display: inline-block; margin-bottom: 8px; color: var(--gold); font-size: .6rem; letter-spacing: .15em; text-transform: uppercase; }
    .collection-feature-note { margin-top: 38px; padding: 30px; border: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 24px; background: linear-gradient(110deg, rgba(201,170,114,.08), transparent 65%); }
    .collection-feature-note h3 { margin: 0 0 7px; }
    .collection-feature-note p { color: var(--muted); margin: 0; max-width: 620px; font-size: .9rem; }
    @media (max-width: 900px) { .collection-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .product-card:nth-child(n+4) { margin-top: 10px; } }
    @media (max-width: 560px) { .collection-grid { grid-template-columns: 1fr; } .product-card:nth-child(n+4) { margin-top: 0; } .collection-feature-note { display: block; padding: 23px; } .collection-feature-note .btn { margin-top: 20px; } .intro-watch { width: 116px; height: 116px; } }
    @media (prefers-reduced-motion: reduce) { .watch-intro { display: none; } }

    /* Navigation */
    .site-header { position: fixed; inset: 0 0 auto; z-index: 100; border-bottom: 1px solid transparent; transition: background .3s ease, border-color .3s ease; }
    .site-header.scrolled { background: rgba(9,13,18,.94); backdrop-filter: blur(16px); border-color: rgba(231,211,168,.13); }
    .nav { width: var(--page); min-height: 82px; margin-inline: auto; display: flex; align-items: center; justify-content: space-between; gap: 30px; }
    .brandmark { display: inline-flex; align-items: center; gap: 12px; flex-shrink: 0; }
    .brand-symbol { width: 34px; height: 34px; border: 1px solid var(--gold); border-radius: 50%; display: grid; place-items: center; color: var(--gold-light); font-family: var(--serif); font-size: 1.2rem; }
    .brand-name { font-family: var(--serif); font-size: 1rem; letter-spacing: .06em; line-height: 1.15; }
    .brand-name small { display: block; margin-top: 4px; font-family: var(--sans); color: var(--gold); font-size: .53rem; letter-spacing: .25em; text-transform: uppercase; }
    .nav-links { display: flex; align-items: center; gap: clamp(18px, 2.6vw, 36px); }
    .nav-links a { color: #d8d6d0; font-size: .72rem; letter-spacing: .07em; transition: color .2s ease; }
    .nav-links a:hover { color: var(--gold-light); }
    .nav-links .nav-cta { padding: 11px 15px; border: 1px solid var(--line); color: var(--gold-light); text-transform: uppercase; letter-spacing: .12em; font-size: .64rem; }
    .menu-toggle { display: none; border: 1px solid var(--line); background: transparent; color: var(--cream); width: 44px; height: 44px; cursor: pointer; }
    .menu-toggle span { display: block; width: 18px; height: 1px; background: currentColor; margin: 5px auto; }

    /* Hero */
    .hero { min-height: min(900px, 100svh); min-height: max(720px, 100svh); position: relative; display: flex; align-items: center; overflow: hidden; background: #0c1219; }
    .hero-image { position: absolute; inset: 0; height: 100%; object-position: center 48%; }
    .hero::before { content: ""; position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgba(5,8,12,.94) 0%, rgba(5,8,12,.78) 39%, rgba(5,8,12,.20) 78%, rgba(5,8,12,.28) 100%), linear-gradient(0deg, rgba(9,13,18,.9), transparent 32%, rgba(9,13,18,.15)); }
    .hero-content { position: relative; z-index: 2; padding-top: 95px; }
    .hero .eyebrow { margin-bottom: 28px; }
    .hero h1 em { color: var(--gold-light); font-style: normal; }
    .hero-copy { max-width: 470px; color: #c4c4c0; font-size: 1rem; margin-bottom: 34px; }
    .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 14px; }
    .hero-note { position: absolute; z-index: 2; bottom: 38px; right: max(24px, calc((100% - 1200px) / 2)); display: flex; align-items: center; gap: 14px; color: #e4dfd4; font-size: .66rem; letter-spacing: .15em; text-transform: uppercase; }
    .hero-note::before { content: ""; width: 42px; height: 1px; background: var(--gold); }
    .scroll-cue { position: absolute; bottom: 36px; left: max(24px, calc((100% - 1200px) / 2)); z-index: 2; display: flex; align-items: center; gap: 12px; color: var(--muted); font-size: .63rem; letter-spacing: .16em; text-transform: uppercase; }
    .scroll-cue span { display: block; height: 40px; width: 1px; background: linear-gradient(var(--gold), transparent); }

    /* Story */
    .story-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 8vw, 120px); align-items: center; }
    .story-image-wrap { position: relative; padding: 0 28px 28px 0; }
    .story-image-wrap::after { content: ""; position: absolute; z-index: -1; inset: 28px 0 0 28px; border: 1px solid var(--gold); opacity: .6; }
    .story-image { height: 590px; object-position: center; filter: saturate(.78); }
    .story-copy p { color: var(--muted); }
    .signature { margin-top: 34px; padding-top: 24px; border-top: 1px solid var(--line); display: flex; align-items: center; gap: 15px; }
    .signature-mark { font-family: var(--serif); font-size: 2.1rem; color: var(--gold); font-style: italic; }
    .signature small { display: block; color: var(--muted); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; }

    /* Collections */
    .collections { background: #0d131a; }
    .collection-top { display: flex; align-items: end; justify-content: space-between; gap: 30px; }
    .collection-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
    .product-card { min-width: 0; }
    .product-image-wrap { position: relative; overflow: hidden; background: #17202a; aspect-ratio: 4 / 5; }
    .product-image { height: 100%; transition: transform .8s cubic-bezier(.2,.65,.25,1); }
    .product-card:hover .product-image { transform: scale(1.045); }
    .product-number { position: absolute; top: 17px; left: 17px; color: #fff; font-size: .64rem; letter-spacing: .16em; }
    .product-info { padding: 23px 2px 0; display: flex; justify-content: space-between; gap: 18px; }
    .product-info h3 { margin: 0 0 8px; }
    .product-info p { color: var(--muted); font-size: .86rem; margin: 0; max-width: 290px; }
    .product-arrow { color: var(--gold); font-size: 1.4rem; transition: transform .2s ease; }
    .product-card:hover .product-arrow { transform: translate(4px,-4px); }
    .collection-foot { margin-top: 46px; padding-top: 22px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 20px; color: var(--muted); font-size: .8rem; }


    .product-card { perspective: 900px; }
    .product-image-wrap { isolation: isolate; }
    .product-image { transform-origin: center; will-change: transform, filter; }
    .product-image-wrap::after { content:""; position:absolute; inset:-40% -80%; z-index:1; pointer-events:none; opacity:0; background:linear-gradient(110deg,transparent 40%,rgba(255,244,210,.36) 49%,rgba(255,255,255,.04) 53%,transparent 61%); transform:translateX(-55%) rotate(8deg); transition:opacity .35s ease; }
    .product-card:hover .product-image-wrap::after { opacity:1; animation:watch-sheen 1.25s ease both; }
    .watch-motion-label { position:absolute; z-index:2; bottom:14px; right:14px; padding:6px 9px; border:1px solid rgba(231,211,168,.55); background:rgba(7,10,13,.62); backdrop-filter:blur(8px); color:#f2dfb5; font-size:.58rem; letter-spacing:.12em; text-transform:uppercase; }
    @keyframes watch-sheen { from{transform:translateX(-55%) rotate(8deg)} to{transform:translateX(55%) rotate(8deg)} }
    @keyframes watch-float { 0%,100%{transform:translateY(0) scale(1.015)} 50%{transform:translateY(-8px) scale(1.04)} }
    @keyframes watch-tilt { 0%,100%{transform:scale(1.025) rotate(0)} 35%{transform:scale(1.06) rotate(1.1deg)} 70%{transform:scale(1.045) rotate(-1deg)} }
    @keyframes watch-zoom { from{transform:scale(1)} to{transform:scale(1.12)} }
    @keyframes watch-pan { from{transform:scale(1.08) translateX(-2%)} to{transform:scale(1.08) translateX(2%)} }
    @keyframes watch-glow { 0%,100%{filter:brightness(1) saturate(.95)} 50%{filter:brightness(1.23) saturate(1.18)} }
    @keyframes watch-drift { 0%,100%{transform:scale(1.03) translateY(0)} 50%{transform:scale(1.07) translateY(-5px)} }
    @keyframes watch-pulse { 0%,100%{transform:scale(1.02);filter:contrast(1)} 50%{transform:scale(1.055);filter:contrast(1.15)} }
    @keyframes watch-turn { 0%,100%{transform:scale(1.02) rotateY(0deg)} 50%{transform:scale(1.055) rotateY(4deg)} }
    @keyframes watch-shift { 0%,100%{transform:scale(1.04) translateX(0)} 50%{transform:scale(1.08) translateX(-7px)} }
    @keyframes watch-focus { 0%,100%{transform:scale(1.02);filter:brightness(.95) blur(0)} 50%{transform:scale(1.06);filter:brightness(1.12) blur(.15px)} }
    @keyframes watch-sway { 0%,100%{transform:scale(1.02) rotate(0)} 50%{transform:scale(1.055) rotate(-1.5deg)} }
    @keyframes watch-ripple { 0%,100%{transform:scale(1.02);filter:saturate(.9)} 50%{transform:scale(1.07);filter:saturate(1.3)} }
    @keyframes watch-scan { 0%,100%{transform:scale(1.02) translateY(0)} 50%{transform:scale(1.055) translateY(6px)} }
    @keyframes watch-rotate { 0%,100%{transform:scale(1.025) rotate(0)} 50%{transform:scale(1.055) rotate(.8deg)} }
    @keyframes watch-shimmer { 0%,100%{filter:brightness(.95) saturate(.9);transform:scale(1.02)} 50%{filter:brightness(1.2) saturate(1.25);transform:scale(1.055)} }
    @keyframes watch-signature { 0%,100%{transform:scale(1.02) translateY(0)} 50%{transform:scale(1.06) translateY(-6px)} }
    .product-card:hover .product-image { animation-duration:2.4s; animation-timing-function:ease-in-out; animation-iteration-count:infinite; }
    .watch-01:hover .product-image { animation-name:watch-float; }
    .watch-02:hover .product-image { animation-name:watch-tilt; }
    .watch-03:hover .product-image { animation-name:watch-zoom; animation-duration:1.6s; }
    .watch-04:hover .product-image { animation-name:watch-pan; }
    .watch-05:hover .product-image { animation-name:watch-glow; }
    .watch-06:hover .product-image { animation-name:watch-drift; }
    .watch-07:hover .product-image { animation-name:watch-pulse; }
    .watch-08:hover .product-image { animation-name:watch-turn; }
    .watch-09:hover .product-image { animation-name:watch-shift; }
    .watch-10:hover .product-image { animation-name:watch-focus; }
    .watch-11:hover .product-image { animation-name:watch-sway; }
    .watch-12:hover .product-image { animation-name:watch-ripple; }
    .watch-13:hover .product-image { animation-name:watch-scan; }
    .watch-14:hover .product-image { animation-name:watch-shimmer; }
    .watch-15:hover .product-image { animation-name:watch-signature; }
    @media (prefers-reduced-motion: reduce) { .product-card:hover .product-image,.product-card:hover .product-image-wrap::after { animation:none!important; } }

    /* Craft */
    .craft-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; align-items: stretch; }
    .craft-feature { min-height: 620px; position: relative; overflow: hidden; }
    .craft-feature img { position: absolute; inset: 0; height: 100%; }
    .craft-feature::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(4,7,10,.94), rgba(4,7,10,.04) 72%); }
    .craft-feature-content { position: absolute; z-index: 1; bottom: 34px; left: 34px; right: 34px; }
    .craft-feature-content p { max-width: 410px; color: #c5c5c0; margin-bottom: 0; }
    .craft-list { display: flex; flex-direction: column; justify-content: center; padding: 16px clamp(10px, 4vw, 54px); }
    .craft-item { padding: 28px 0; border-bottom: 1px solid var(--line); display: grid; grid-template-columns: 45px 1fr; gap: 20px; }
    .craft-item:first-child { border-top: 1px solid var(--line); }
    .craft-index { font-family: var(--serif); font-size: 1.35rem; color: var(--gold); }
    .craft-item h3 { font-size: 1.55rem; margin-bottom: 8px; }
    .craft-item p { color: var(--muted); font-size: .88rem; margin: 0; }

    /* Bespoke */
    .bespoke { background: #e9e2d5; color: #111820; }
    .bespoke .eyebrow { color: #80653b; }
    .bespoke .eyebrow::before { background: #9a7845; }
    .bespoke .section-heading p { color: #5f625f; }
    .bespoke-layout { display: grid; grid-template-columns: .85fr 1.15fr; gap: 80px; align-items: start; }
    .bespoke-aside { position: sticky; top: 120px; }
    .bespoke-aside .btn { color: #111820; border-color: #80653b; }
    .bespoke-aside .btn:hover { background: #80653b; color: #fff; }
    .steps { border-top: 1px solid rgba(17,24,32,.2); }
    .step { display: grid; grid-template-columns: 55px 1fr; gap: 24px; padding: 28px 0; border-bottom: 1px solid rgba(17,24,32,.2); }
    .step-no { color: #967546; font-family: var(--serif); font-size: 1.6rem; }
    .step h3 { font-size: 1.7rem; }
    .step p { color: #5f625f; margin: 0; max-width: 470px; }

    /* Quote */
    .quote-section { padding: 110px 0; text-align: center; }
    .quote-mark { color: var(--gold); font-family: var(--serif); font-size: 5rem; line-height: .8; }
    blockquote { max-width: 850px; margin: 22px auto 30px; font-family: var(--serif); font-size: clamp(1.8rem, 4vw, 3.4rem); line-height: 1.25; letter-spacing: -.025em; }
    .quote-credit { color: var(--gold-light); font-size: .68rem; letter-spacing: .17em; text-transform: uppercase; }
    .quote-disclaimer { color: #777d81; font-size: .7rem; margin: 20px auto 0; max-width: 560px; }

    /* Contact */
    .contact { background: #0d131a; }
    .contact-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(40px, 8vw, 120px); align-items: start; }
    .contact-copy p { color: var(--muted); max-width: 430px; }
    .contact-detail { padding-top: 26px; margin-top: 28px; border-top: 1px solid var(--line); }
    .contact-detail span { display: block; color: var(--gold); font-size: .64rem; letter-spacing: .17em; text-transform: uppercase; margin-bottom: 7px; }
    .contact-detail a, .contact-detail p { color: #d8d6d0; font-size: .92rem; margin: 0; }
    .contact-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
    .contact-action { display: inline-flex; align-items: center; gap: 8px; border: 1px solid rgba(231,211,168,.28); padding: 11px 14px; color: var(--cream); font-size: .75rem; transition: background .2s, border-color .2s; }
    .contact-action:hover { background: rgba(231,211,168,.08); border-color: var(--gold); }
    .whatsapp-float { position: fixed; right: 20px; bottom: 20px; z-index: 50; display: inline-flex; align-items: center; gap: 9px; padding: 13px 17px; background: #1e9e60; color: white; border-radius: 999px; box-shadow: 0 8px 30px rgba(0,0,0,.3); font-size: .82rem; font-weight: 600; }
    .whatsapp-float:hover { background: #16834e; }
    @media (max-width: 480px) { .whatsapp-float { right: 12px; bottom: 12px; padding: 12px 14px; } }
    .contact-form { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .field { display: flex; flex-direction: column; gap: 9px; }
    .field.full { grid-column: 1 / -1; }
    label { color: #d8d6d0; font-size: .72rem; letter-spacing: .06em; }
    input, textarea, select { width: 100%; border: 1px solid rgba(231,211,168,.22); background: #101820; color: var(--cream); padding: 14px 15px; border-radius: 0; outline: none; }
    input:focus, textarea:focus, select:focus { border-color: var(--gold); }
    input::placeholder, textarea::placeholder { color: #747d83; }
    textarea { min-height: 130px; resize: vertical; }
    select { color-scheme: dark; }
    .form-note { grid-column: 1 / -1; color: #8c9396; font-size: .74rem; margin: -5px 0 0; }
    .form-status { grid-column: 1 / -1; color: var(--gold-light); font-size: .86rem; min-height: 1.4em; }
    .contact-form .btn { justify-self: start; }

    /* Footer */
    footer { padding: 32px 0; background: #080b0f; border-top: 1px solid rgba(231,211,168,.13); }
    .footer-main { display: flex; justify-content: space-between; align-items: center; gap: 30px; padding-bottom: 28px; }
    .footer-links { display: flex; flex-wrap: wrap; gap: 22px; color: var(--muted); font-size: .72rem; }
    .footer-links a:hover { color: var(--gold-light); }
    .footer-bottom { display: flex; justify-content: space-between; gap: 20px; padding-top: 22px; border-top: 1px solid rgba(231,211,168,.1); color: #7e8589; font-size: .68rem; }
    .socials { display: flex; gap: 16px; }
    .socials a { color: var(--muted); }
    .socials a:hover { color: var(--gold-light); }

    /* Motion */
    .reveal { opacity: 0; transform: translateY(22px); transition: opacity .8s ease, transform .8s ease; }
    .reveal.is-visible { opacity: 1; transform: translateY(0); }
    .delay-1 { transition-delay: .12s; }
    .delay-2 { transition-delay: .22s; }
    .delay-3 { transition-delay: .32s; }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; }
      .reveal { opacity: 1; transform: none; }
    }

    @media (max-width: 900px) {
      :root { --page: min(100% - 40px, 700px); }
      .section { padding: 88px 0; }
      .nav { min-height: 74px; }
      .menu-toggle { display: block; }
      .nav-links { display: none; position: fixed; inset: 74px 0 auto; padding: 25px 24px 32px; background: rgba(9,13,18,.98); border-bottom: 1px solid var(--line); flex-direction: column; align-items: stretch; gap: 0; }
      .nav-links.open { display: flex; }
