      .hero { min-height: 780px; min-height: 100svh; }
      .hero::before { background: linear-gradient(90deg, rgba(5,8,12,.86), rgba(5,8,12,.4)), linear-gradient(0deg, rgba(9,13,18,.85), transparent 55%); }
      .hero-image { object-position: 62% center; }
      .hero-content { padding-top: 75px; }
      .hero-note { display: none; }
      .story-grid, .craft-grid, .bespoke-layout, .contact-grid { grid-template-columns: 1fr; gap: 44px; }
      .story-image-wrap { max-width: 570px; }
      .story-image { height: 480px; }
      .collection-grid { grid-template-columns: repeat(2, 1fr); gap: 28px 18px; }
      .craft-feature { min-height: 520px; }
      .craft-list { padding: 0; }
      .bespoke-aside { position: static; }
      .contact-grid { gap: 52px; }
    }
    @media (max-width: 560px) {
      :root { --page: calc(100% - 36px); }
      .section { padding: 72px 0; }
      .nav { min-height: 70px; }
      .brand-symbol { width: 31px; height: 31px; }
      .brand-name { font-size: .88rem; }
      .hero { min-height: 760px; min-height: 100svh; }
      .hero-image { object-position: 59% center; }
      .hero::before { background: linear-gradient(90deg, rgba(5,8,12,.84), rgba(5,8,12,.4)), linear-gradient(0deg, rgba(9,13,18,.96), transparent 70%); }
      h1 { font-size: clamp(3.2rem, 16vw, 5.1rem); }
      h2 { font-size: clamp(2.45rem, 12vw, 3.6rem); }
      .hero-copy { font-size: .92rem; max-width: 350px; }
      .hero-actions { align-items: stretch; flex-direction: column; max-width: 310px; }
      .hero-actions .btn { width: 100%; }
      .scroll-cue { bottom: 22px; left: 18px; }
      .story-image-wrap { padding: 0 17px 17px 0; }
      .story-image-wrap::after { inset: 17px 0 0 17px; }
      .story-image { height: 390px; }
      .collection-top { display: block; }
      .collection-top .btn { margin-top: 10px; }
      .collection-grid { grid-template-columns: 1fr; gap: 34px; }
      .product-image-wrap { aspect-ratio: 4 / 4.6; }
      .product-info { padding-top: 17px; }
      .collection-foot { display: block; line-height: 1.8; }
      .craft-feature { min-height: 460px; }
      .craft-feature-content { bottom: 24px; left: 22px; right: 22px; }
      .craft-item { grid-template-columns: 35px 1fr; gap: 14px; padding: 23px 0; }
      .step { grid-template-columns: 38px 1fr; gap: 14px; padding: 24px 0; }
      .quote-section { padding: 80px 0; }
      .contact-form { grid-template-columns: 1fr; }
      .field.full, .form-note, .form-status { grid-column: auto; }
      .contact-form .btn { width: 100%; }
      .footer-main, .footer-bottom { align-items: flex-start; flex-direction: column; }
      .footer-links { gap: 14px 20px; }
    }

    /* Premium watch detail experience */
    .product-card > a { display:block; height:100%; cursor:pointer; }
    .product-card:focus-within { outline:1px solid rgba(231,211,168,.6); outline-offset:6px; }
    .product-price { display:block; margin-top:12px; color:var(--gold-light); font-size:.68rem; letter-spacing:.14em; text-transform:uppercase; }
    .watch-modal { position:fixed; inset:0; z-index:10001; display:none; place-items:center; padding:22px; background:rgba(0,0,0,.82); backdrop-filter:blur(12px); }
    .watch-modal.open { display:grid; animation:modal-fade .25s ease both; }
    .watch-modal-panel { position:relative; width:min(900px,100%); max-height:min(88vh,760px); overflow:auto; display:grid; grid-template-columns:1fr 1fr; background:linear-gradient(135deg,#17202a,#080b0f 70%); border:1px solid rgba(201,170,114,.42); box-shadow:0 30px 100px #000; }
    .watch-modal-visual { min-height:430px; overflow:hidden; background:#111820; position:relative; display:grid; place-items:center; }
    .watch-modal-visual::after { content:""; position:absolute; inset:0; pointer-events:none; background:linear-gradient(120deg,transparent 30%,rgba(231,211,168,.18) 48%,transparent 62%); transform:translateX(-100%); animation:modal-sheen 4s ease-in-out infinite; }
    .watch-modal-visual img { width:100%; height:100%; min-height:430px; object-fit:cover; animation:modal-watch-arrive .9s cubic-bezier(.2,.8,.2,1) both; }
